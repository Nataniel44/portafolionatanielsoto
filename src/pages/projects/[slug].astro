---
export const prerender = true;
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const slug = project.id;
const { title, description, date, image, tags, url } = project.data;
---

<Layout title={title}>
  <article class="max-w-3xl mx-auto">
    <div data-aos="fade-up" class="relative overflow-hidden rounded-xl mb-8 card-glow group">
      <a href={url} target="_blank" rel="noopener noreferrer" class="block relative">
        <img
          src={image}
          alt={title}
          transition:name="img-card"
          class="w-full h-72 md:h-96 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0f] via-[#0a0a0f]/40 to-transparent"></div>
        <div class="absolute top-4 right-4 w-8 h-8 rounded-full bg-white/5 backdrop-blur-md border border-white/10 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/80"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </div>
      </a>
      <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8 pointer-events-none">
        <div class="flex flex-wrap gap-2 mb-3">
          {tags.map((tag) => (
            <span class="px-3 py-1 text-[10px] font-medium bg-white/5 backdrop-blur-sm text-white/60 rounded-full border border-white/5">{tag}</span>
          ))}
        </div>
        <h1 class="text-2xl md:text-3xl font-bold text-white/90">{title}</h1>
        <div class="flex items-center gap-3 mt-2 text-sm text-neutral-500">
          <time datetime={date.toISOString()}>{date.toLocaleDateString("es-AR", { year: "numeric", month: "long" })}</time>
        </div>
      </div>
    </div>

    <div data-aos="fade-up" data-aos-delay="100" class="px-0 md:px-2">
      <p class="text-base text-neutral-300 leading-relaxed mb-8">{description}</p>

      <div class="text-neutral-400 leading-relaxed space-y-4 mb-10 text-sm">
        {project.body}
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-12">
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-navy flex items-center justify-center gap-2 px-6 py-3 text-sm font-semibold rounded-lg"
        >
          Visitar proyecto
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
        </a>
        <a
          href="/"
          class="flex items-center justify-center gap-2 px-6 py-3 border border-white/5 hover:border-blue-500/20 text-neutral-500 hover:text-blue-300 font-medium rounded-lg transition-all duration-300 text-sm"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Volver
        </a>
      </div>
    </div>
  </article>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll(".card-glow").forEach((card) => {
      const img = card.querySelector("img");
      if (!img) return;
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
        const x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        const y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        img.style.setProperty("--tx", `${-x * 8}px`);
        img.style.setProperty("--ty", `${-y * 8}px`);
      });
      card.addEventListener("mouseleave", () => {
        img.style.removeProperty("--tx");
        img.style.removeProperty("--ty");
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const delay = entry.target.dataset.aosDelay || "0";
            entry.target.style.transitionDelay = `${delay}ms`;
            entry.target.classList.add("aos-animate");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );

    document.querySelectorAll(".aos-init").forEach((el) => {
      if (!el.classList.contains("aos-animate")) {
        observer.observe(el);
      }
    });
  });
</script>
