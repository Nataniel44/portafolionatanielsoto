---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
const destacados = projects.filter((p) => p.id === "proyecto5" || p.id === "proyecto3" || p.id === "proyecto2");
const todos = projects;
---

<Layout>
  <div data-aos="fade-up" class="text-center md:items-start md:text-start gap-10 flex flex-col md:grid md:grid-cols-12 text-balance">
    <div class="md:sticky top-28 flex flex-col md:col-span-3 gap-6 sm:max-w-sm sm:mx-auto lg:max-w-none lg:mx-0">
      <div class="glass-card p-6 flex flex-col items-center md:items-start gap-5">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-br from-blue-500/20 to-cyan-500/10 rounded-full blur-2xl"></div>
          <div class="flex w-full justify-center md:justify-start relative">
            <img src="/soto.png" alt="Nataniel Soto" class="object-cover w-48 h-48 md:w-44 md:h-44 rounded-xl ring-2 ring-blue-500/10">
          </div>
        </div>
        <div class="leading-6">
          <p class="md:w-full mx-auto text-neutral-400 text-sm md:text-start text-balance leading-relaxed">
            Soy de <span class="bg-gradient-to-r font-bold from-blue-400 to-cyan-400 inline-block text-transparent bg-clip-text">Argentina</span>, tengo 21 años. Me apasiona la creación de soluciones innovadoras y funcionales, siempre busco mejorar mis habilidades para ofrecer desarrollos de alta calidad.
          </p>
        </div>
        <div class="flex gap-3 justify-center items-center md:items-start flex-col w-full">
          <div class="flex gap-2">
            <a href="./jose_nataniel_soto.pdf" target="_blank" class="btn-navy uppercase tracking-wider text-sm font-semibold px-5 py-2.5 rounded-lg">
              Descargar <span class="font-bold text-white">CV</span>
            </a>
          </div>
          <div class="flex space-x-3">
            <a href="https://www.instagram.com/nata.st44/" class="text-neutral-600 hover:text-blue-400 transition-all duration-300 hover:scale-110" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
            <a href="https://github.com/Nataniel44" target="_blank" class="text-neutral-600 hover:text-blue-400 transition-all duration-300 hover:scale-110" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2a10 10 0 0 0-3.16 19.47c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34a2.66 2.66 0 0 0-1.11-1.48c-.9-.61.07-.6.07-.6a2.1 2.1 0 0 1 1.52 1 2.14 2.14 0 0 0 2.94.83 2.13 2.13 0 0 1 .64-1.35c-2.22-.25-4.56-1.11-4.56-4.95a3.88 3.88 0 0 1 1-2.7 3.63 3.63 0 0 1 .1-2.66s.84-.27 2.75 1a9.48 9.48 0 0 1 5 0c1.9-1.31 2.75-1 2.75-1a3.63 3.63 0 0 1 .1 2.66 3.88 3.88 0 0 1 1 2.7c0 3.86-2.34 4.7-4.57 4.94a2.39 2.39 0 0 1 .68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path>
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/nataniel-soto-52922726a/" target="_blank" class="text-neutral-600 hover:text-blue-400 transition-all duration-300 hover:scale-110" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="md:col-span-9 space-y-10">
      <div data-aos="fade-up">
        <h3 class="font-bold text-white/90 text-xs tracking-[0.3em] uppercase mb-5">
          <span class="bg-gradient-to-r from-blue-400 to-cyan-400 inline-block text-transparent bg-clip-text">
            Proyectos Destacados
          </span>
        </h3>
        <div class="grid grid-cols-3 sm:grid-cols-9 h-auto gap-4 w-full">
          {destacados.slice(0, 3).map((p, i) => {
            const spans = i === 0 ? "col-span-3 sm:col-span-5" : i === 1 ? "col-span-3 sm:col-span-4" : "col-span-3 sm:col-span-9";
            return (
              <a href={`/projects/${p.id}`} class={`overflow-hidden rounded-xl relative group cursor-pointer ${spans} card-glow`} data-aos="fade-up" data-aos-delay={i * 100}>
                <img src={p.data.image} alt="" class="h-56 w-full object-top object-cover opacity-60 group-hover:opacity-100">
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0f] via-[#0a0a0f]/60 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-300"></div>
                <div class="absolute bottom-4 left-4 right-4">
                  <span class="text-xs font-semibold uppercase tracking-wider text-white/70 group-hover:text-blue-300 transition-colors duration-300">{p.data.title}</span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <div class="relative pt-16 mt-6">
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-blue-500/15 to-transparent"></div>
      </div>

      <div data-aos="fade-up" data-aos-delay="150">
        <h2 class="font-bold text-white/90 text-xs tracking-[0.3em] uppercase mb-5">
          <span class="bg-gradient-to-r from-blue-400 to-cyan-400 inline-block text-transparent bg-clip-text">
            Todos los proyectos
          </span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {todos.map((p, i) => {
            const tall = i === 0 || i === 3 ? "md:row-span-2 md:h-full" : "";
            const height = i === 0 || i === 3 ? "h-56 md:h-full" : "h-48";
            return (
              <a href={`/projects/${p.id}`} class={`group relative overflow-hidden rounded-xl card-glow ${tall}`} data-aos="fade-up" data-aos-delay={i * 60}>
                <img src={p.data.image} alt={p.data.title} class={`w-full ${height} object-cover`}>
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0f] via-[#0a0a0f]/40 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-300"></div>
                <div class="absolute bottom-4 left-4 right-4">
                  <h3 class="text-sm font-semibold text-white/90 group-hover:text-blue-300 transition-colors duration-300">{p.data.title}</h3>
                  <p class="text-xs text-neutral-500 mt-0.5 line-clamp-1">{p.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <footer data-aos="fade-up" class="w-full text-center py-8 border-t border-blue-500/5">
    <div class="flex gap-3 justify-center items-center flex-col">
      <div class="flex gap-3">
        <a href="https://github.com/Nataniel44" target="_blank" class="text-neutral-600 hover:text-blue-400 transition-all duration-300 hover:scale-110" aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 0 0-3.16 19.47c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34a2.66 2.66 0 0 0-1.11-1.48c-.9-.61.07-.6.07-.6a2.1 2.1 0 0 1 1.52 1 2.14 2.14 0 0 0 2.94.83 2.13 2.13 0 0 1 .64-1.35c-2.22-.25-4.56-1.11-4.56-4.95a3.88 3.88 0 0 1 1-2.7 3.63 3.63 0 0 1 .1-2.66s.84-.27 2.75 1a9.48 9.48 0 0 1 5 0c1.9-1.31 2.75-1 2.75-1a3.63 3.63 0 0 1 .1 2.66 3.88 3.88 0 0 1 1 2.7c0 3.86-2.34 4.7-4.57 4.94a2.39 2.39 0 0 1 .68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/nataniel-soto-52922726a/" target="_blank" class="text-neutral-600 hover:text-blue-400 transition-all duration-300 hover:scale-110" aria-label="LinkedIn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
      <p class="text-xs text-neutral-600">&copy; 2025 Nataniel Soto</p>
    </div>
  </footer>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const delay = entry.target.dataset.aosDelay || "0";
            entry.target.style.transitionDelay = `${delay}ms`;
            entry.target.classList.add("aos-animate");
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
    );

    document.querySelectorAll(".aos-init").forEach((el) => {
      if (!el.classList.contains("aos-animate")) {
        observer.observe(el);
      }
    });

    document.querySelectorAll(".card-glow").forEach((card) => {
      const img = card.querySelector("img");
      if (!img) return;
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
        card.style.setProperty("--my", `${e.clientY - rect.top}px`);
        const x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
        const y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
        img.style.setProperty("--tx", `${-x * 8}px`);
        img.style.setProperty("--ty", `${-y * 8}px`);
      });
      card.addEventListener("mouseleave", () => {
        img.style.removeProperty("--tx");
        img.style.removeProperty("--ty");
      });
    });
  });
</script>
